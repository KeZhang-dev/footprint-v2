# Copy this file to .env.production (or .env, gitignored) before running
# `npm run build` for a deployment where the frontend and API are NOT
# served from the same origin (e.g. separate Render services).
#
# Leave unset for local dev (Vite's proxy in vite.config.ts handles it) and
# for the docker-compose deployment (nginx.conf proxies /api and /uploads
# to the api container) — in both cases requests stay same-origin.
#
# Vite only exposes VITE_-prefixed vars to client code, and bakes this in
# at build time (not read at runtime), so it must be set before `npm run
# build`, e.g. as a build-time env var in Render's dashboard for the
# frontend service.
VITE_API_BASE_URL=https://footprint-v2.onrender.com
